# ─────────────────────────────────────────────────────────────────────────────
# Dozanta – Environment Variables
# Copy this file to .env.local for local development.
# Set every variable in your hosting provider's dashboard for production.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Railway: copy the connection string from your PostgreSQL service's Variables tab.
# Local:   postgresql://postgres:password@localhost:5432/dozanta
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"


# ── NextAuth ──────────────────────────────────────────────────────────────────
# Public URL of your deployment (no trailing slash).
# Vercel: set to your production domain, e.g. https://dozanta.vercel.app
# Railway: set to your Railway domain, e.g. https://dozanta.up.railway.app
NEXTAUTH_URL="https://your-domain.com"

# Random secret used to encrypt JWTs and cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32-output"


# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"


# ── Magic-link Email ──────────────────────────────────────────────────────────
# SMTP connection string used by NextAuth EmailProvider.
# Resend (recommended): smtp://resend:re_YOUR_API_KEY@smtp.resend.com:465
# Postmark:             smtp://postmark:POSTMARK_TOKEN@smtp.postmarkapp.com:587
# Leave empty to disable email sign-in (Google OAuth still works).
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Dozanta <noreply@your-domain.com>"


# ── Alpaca Markets ────────────────────────────────────────────────────────────
# Paper-trading API keys from https://alpaca.markets → Paper Trading → API Keys
# Leave empty (or omit) to run in simulation mode (no real market data, no trades).
ALPACA_API_KEY="PKyour-alpaca-api-key"
ALPACA_API_SECRET="your-alpaca-api-secret"

# Paper trading endpoint (default). Switch to https://api.alpaca.markets for live trading.
ALPACA_BASE_URL="https://paper-api.alpaca.markets"


# ── Stripe ────────────────────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"

# Webhook secret – create endpoint at https://dashboard.stripe.com/webhooks
# Events required: customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-signing-secret"

# Price ID of the PRO subscription product (Stripe Dashboard → Products → PRO plan)
STRIPE_PRO_PRICE_ID="price_your-pro-price-id"


# ── Anthropic ─────────────────────────────────────────────────────────────────
# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"


# ── Cron Security ─────────────────────────────────────────────────────────────
# Secret that protects /api/cron/strategies from unauthorized calls.
# Vercel Cron injects this automatically from your environment.
# For Railway or external cron: generate a random value and pass it as
# an Authorization: Bearer <CRON_SECRET> header when calling the endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-openssl-rand-hex-32-output"
